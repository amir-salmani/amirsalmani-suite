{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "allowJs": true, "checkJs": false,
    "strict": false, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "paths": {
      "@ui/*": ["./src/suite/components/ui/*"], "@components/*": ["./src/suite/components/*"],
      "@hooks/*": ["./src/suite/hooks/*"], "@lib/*": ["./src/suite/lib/*"],
      "@suite/*": ["./src/suite/*"], "@/*": ["./src/suite/*"]
    }
  },
  "include": ["src"]
}
