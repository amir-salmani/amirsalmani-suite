# Serves the baked site and nothing else. No TLS and no redirects here — Traefik
# terminates and canonicalises at the edge, and doing it twice is how a redirect
# loop happens.
:80 {
	root * /srv
	encode zstd gzip

	# Hashed assets are named for their own bytes: a change changes the URL, so
	# they can be held for a year and never need purging. Everything else —
	# HTML, the registry JSON, the recordings — revalidates, because those names
	# are stable and their contents are not.
	# Both matchers are explicit. A bare `header` alongside a matched one wins
	# regardless of order, so the second rule states its own complement rather
	# than relying on falling through.
	@hashed path_regexp \.[0-9a-f]{8}\.(css|js)$
	@unhashed not path_regexp \.[0-9a-f]{8}\.(css|js)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "public, max-age=0, must-revalidate"

	file_server {
		precompressed br gzip
	}

	# The healthcheck compose and Docker both read. Deliberately not a file, so
	# it cannot be shadowed by the site's own content.
	respond /healthz 200 {
		body "ok"
		close
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
