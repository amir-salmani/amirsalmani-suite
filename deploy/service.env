# Sourced by bash in reconcile.sh and bootstrap.sh, so any value containing a
# space is quoted. BUILD=npm run ci without quotes runs `run ci`.
#
# The whole contract. See codebase/templates/deploy/README.md.
SERVICE=amirsalmani-suite
OWNER=amir-salmani/amirsalmani-suite
HOST=amirsalmani.com
PATHS=/suite,/r
BUILD="npm run ci"
OUTDIR=dist
